<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  ==========================================================
	  GHShield - Grasshopper protection layer
	  ==========================================================
	  Target host : Rhino 7 / Grasshopper 7
	  Runtime     : .NET Framework 4.8 (Rhino 7 has no .NET Core host)
	  Output      : GHShield.gha  ->  bin\Debug\GHShield.gha
	  ==========================================================
	-->

	<PropertyGroup>
		<!-- Rhino 7 runs on .NET Framework 4.8 ONLY. Do not multi-target. -->
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>

		<AssemblyName>GHShield</AssemblyName>
		<RootNamespace>GHShield</RootNamespace>

		<!-- Grasshopper loads .gha, not .dll -->
		<TargetExt>.gha</TargetExt>

		<!-- Flat output: bin\Debug\ instead of bin\Debug\net48\ -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<!-- WinForms + System.Drawing: required by the Grasshopper canvas API -->
		<UseWindowsForms>true</UseWindowsForms>

		<!-- The Grasshopper NuGet package is built for .NET Framework;
		     NU1701 fires on some transitive packages and is expected. -->
		<NoWarn>NU1701</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Assembly / Yak metadata -->
		<Version>1.1.0</Version>
		<Title>GHShield</Title>
		<Company>ALVA</Company>
		<Authors>Nipun</Authors>
		<Description>Protection and access control for existing Grasshopper components.</Description>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!-- 'full' PDBs attach most reliably when debugging into Rhino 7. -->
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<ItemGroup>
		<!-- Rhino 7 / Grasshopper reference assemblies.
		     ExcludeAssets="runtime" keeps RhinoCommon.dll and Grasshopper.dll
		     OUT of the output folder - Rhino supplies them at load time.
		     Never ship them inside the .gha. -->
		<PackageReference Include="Grasshopper" Version="7.0.20314.3001" ExcludeAssets="runtime" />

		<!-- Harmony: runtime method interception.
		     Grasshopper's removal methods are public but NOT virtual, and it
		     raises no pre-delete event, so there is no supported way to veto a
		     deletion. Harmony is how Rhino plugins solve exactly this.
		     0Harmony.dll IS copied to the output folder and must ship with
		     the .gha. -->
		<PackageReference Include="Lib.Harmony" Version="2.4.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- Icons are embedded in the .gha so it stays a single file.
		     The Remove comes first: the SDK globs *.png into None by default,
		     and the same file in two item groups trips a duplicate-item error
		     on some SDK versions. -->
		<Compile Remove="Security\**" />
		<Compile Remove="Serialization\**" />
		<EmbeddedResource Remove="Security\**" />
		<EmbeddedResource Remove="Serialization\**" />
		<None Remove="Resources\*.png" />
		<None Remove="Security\**" />
		<None Remove="Serialization\**" />
		<EmbeddedResource Include="Resources\*.png" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Components\" />
		<Folder Include="Resources\" />
		<Folder Include="UI\" />
	</ItemGroup>

	<!--
	  ==========================================================
	  Yak packaging (opt-in, Release only)
	  ==========================================================
	  Run:  dotnet build -c Release -p:BuildYakPackage=true
	  It is deliberately OFF during normal development so a
	  missing Yak.exe can never fail a Debug build.
	-->
	<Target Name="BuildYakPackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(BuildYakPackage)' == 'true'">

		<PropertyGroup>
			<YakExecutable Condition="'$(YakExecutable)' == '' and Exists('C:\Program Files\Rhino 7\System\Yak.exe')">C:\Program Files\Rhino 7\System\Yak.exe</YakExecutable>
		</PropertyGroup>

		<Error Text="Yak.exe not found. Pass -p:YakExecutable=&lt;path&gt;." Condition="'$(YakExecutable)' == ''" />

		<ItemGroup>
			<YakPackagesToDelete Include="$(OutputPath)*.yak;$(OutputPath)**\manifest.yml" />
		</ItemGroup>

		<Delete Files="@(YakPackagesToDelete)" />

		<Exec Command="&quot;$(YakExecutable)&quot; spec" WorkingDirectory="$(OutputPath)" />
		<Exec Command="&quot;$(YakExecutable)&quot; build" WorkingDirectory="$(OutputPath)" />
	</Target>

</Project>
